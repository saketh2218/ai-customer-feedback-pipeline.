# Copy this file to .env (or export the variable in your shell) to enable
# live LLM-powered sentiment enrichment instead of the heuristic fallback.
#
#   cp .env.example .env
#   export OPENAI_API_KEY=sk-...   (or use a tool like python-dotenv / direnv)
#
# Without this key set, the pipeline runs fully offline using a
# deterministic keyword-based heuristic in llm_sentiment_enricher.py.

OPENAI_API_KEY=

# Optional: override the default model (gpt-4o-mini)
LLM_MODEL=gpt-4o-mini
